# Janet Separated Services Configuration
# Copy this file to .env and fill in your actual values

# Slack Bot Configuration (required for both services)
JANET_SLACK_TOKEN=xoxb-your-bot-token-here
JANET_SLACK_SOCKET_TOKEN=xapp-your-socket-token-here
JANET_GOOD_PLACE_JUDGE_BOT_ID=your-bot-user-id-here

# Web UI Configuration
JANET_WEB_PASSWORD=your-secure-admin-password-here

# Database Configuration (shared between services)
JANET_DATABASE_DRIVER=postgres
JANET_DATABASE_URL=postgres://janet:password@postgres:5432/janet?sslmode=disable

# Optional Bot Configuration
JANET_MAX_POINTS=5
JANET_LEADERBOARD_LIMIT=10
JANET_REPLY_TYPE=message
JANET_DEBUG=false
JANET_SELF_KARMA=false
JANET_MOTIVATE=true
JANET_REACTJI_ENABLED=true

# Bot Personalities (optional)
JANET_GOOD_USERNAME=Good Janet
JANET_GOOD_ICON_URL=
JANET_BAD_USERNAME=Bad Janet
JANET_BAD_ICON_URL=