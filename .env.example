# Janet Separated Services Configuration
# Copy this file to .env and fill in your actual values

# Slack Bot Configuration (required for both services)
# Slack app setup:
# - Socket Mode enabled with app-level scope: connections:write
# - Bot scopes include: app_mentions:read, channels:history, channels:read, chat:write,
#   groups:history, groups:read, reactions:read, users:read
# - Bot events include: app_mention, message.channels, message.groups,
#   reaction_added, reaction_removed
# Reinstall the Slack app after adding scopes so JANET_SLACK_TOKEN has them.
JANET_SLACK_TOKEN=xoxb-your-bot-token-here
JANET_SLACK_SOCKET_TOKEN=xapp-your-socket-token-here
JANET_GOOD_PLACE_JUDGE_BOT_ID=your-bot-user-id-here

# Web UI Configuration
JANET_WEB_PASSWORD=your-secure-admin-password-here
JANET_ATTACHMENTS_DIR=attachments
JANET_RUN_CHANNELID_BACKFILL=false
# Slack token for web API
# - Use a User Token (xoxp-) with scopes: search:read, channels:history, groups:history
#   This enables finding missing channel_ids via search and fetching message text
# - OR use a Bot Token (xoxb-) with scopes: channels:history, groups:history, groups:read
#   This only fetches text for messages that already have channel_id in the database
JANET_WEB_TOKEN=xoxp-your-user-token-here

# Database Configuration (shared between services)
JANET_DATABASE_DRIVER=postgres
JANET_DATABASE_URL=postgres://janet:password@postgres:5432/janet?sslmode=disable

# Optional Bot Configuration
JANET_MAX_POINTS=5
JANET_LEADERBOARD_LIMIT=10
JANET_REPLY_TYPE=message
JANET_DEBUG=false
JANET_SELF_KARMA=false
JANET_MOTIVATE=true
JANET_REACTJI_ENABLED=true

# Bot Personalities (optional)
JANET_GOOD_USERNAME=Good Janet
JANET_GOOD_ICON_URL=
JANET_BAD_USERNAME=Bad Janet
JANET_BAD_ICON_URL=


# OAuth2 proxy config
# Use the OAuth client created in Google Cloud Console.
OAUTH2_PROXY_CLIENT_ID=
OAUTH2_PROXY_CLIENT_SECRET=
# 32-byte base64-encoded secret, e.g. `openssl rand -base64 32`
OAUTH2_PROXY_COOKIE_SECRET=
OAUTH2_PROXY_EMAIL_DOMAINS=madebymode.com
# Local testing example:
# OAUTH2_PROXY_REDIRECT_URL=http://localhost:8080/oauth2/callback
# OAUTH2_PROXY_COOKIE_SECURE=false
# Production example:
# OAUTH2_PROXY_REDIRECT_URL=https://janet.madebymode.com/oauth2/callback
# OAUTH2_PROXY_COOKIE_SECURE=true
OAUTH2_PROXY_REDIRECT_URL=
OAUTH2_PROXY_COOKIE_SECURE=true
OAUTH2_PROXY_COOKIE_HTTPONLY=true
OAUTH2_PROXY_COOKIE_SAMESITE=lax
